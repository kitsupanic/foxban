# Local values for `wrangler dev` (and therefore the Playwright e2e suite), passed
# with --env-file by the scripts in package.json. Not secrets: the e2e helpers
# depend on these exact values, so the file is committed rather than ignored.
# The root wrangler.jsonc holds no instance values and ADMIN_EMAILS is a secret
# in production, so this is where local development gets it.
ADMIN_EMAILS="*@admin.test"

# GitHub against the e2e stub server (apps/web/e2e/github-stub.mjs), not
# github.com: no real credentials here, and the full handshake runs offline.
# APP_ORIGIN is the Vite server, so the callback redirect lands on the dev SPA.
GITHUB_OAUTH_BASE=http://localhost:8788
GITHUB_API_BASE=http://localhost:8788
APP_ORIGIN=http://localhost:5173

# Seals the instance GitHub App's secrets in D1 (base64 of 32 bytes). A published
# test key, as in vitest.config.ts: never a real deployment's key.
GITHUB_APP_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

