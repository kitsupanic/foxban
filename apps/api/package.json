{
  "name": "@foxban/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "cd ../.. && wrangler dev --env-file apps/api/.dev.vars",
    "types": "cd ../.. && wrangler types apps/api/worker-configuration.d.ts --env-file apps/api/.dev.vars --strict-vars=false",
    "typecheck": "pnpm run types && tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local -c ../../wrangler.jsonc"
  },
  "dependencies": {
    "@foxban/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/server": "2.0.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@modelcontextprotocol/client": "2.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
