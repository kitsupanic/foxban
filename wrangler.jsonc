{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foxban",
  "main": "apps/api/src/index.ts",
  // Capped by @cloudflare/vitest-pool-workers' bundled workerd, which supports
  // no date newer than 2026-08-22.
  "compatibility_date": "2026-08-22",
  // Deploys to https://foxban.<your-subdomain>.workers.dev. scripts/deploy.mjs
  // can add a custom domain; see .env.deploy.example.
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_DO", "class_name": "BoardDO" },
      { "name": "PRESENCE_DO", "class_name": "PresenceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PresenceDO"] }
  ],
  // Users, sessions, boards and memberships only — board content stays in the DO.
  // No database_id on purpose: the Deploy to Cloudflare button creates the
  // database and writes the id back, and scripts/deploy.mjs fills it in.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxban",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  // Card attachments. Objects are keyed `boardId/uuid` and only ever read
  // through the membership-checked `/boards/:id/attachments/:key` route.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "foxban-attachments" }],
  // The SPA is served from the same origin as the API, so the session cookie and
  // the board socket need no cross-origin handling. `run_worker_first` lists the
  // Worker's own paths (including the `/boards/:id/ws` upgrade); anything else
  // that is not a real file in apps/web/dist falls back to index.html.
  "assets": {
    "directory": "apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/mcp", "/mcp/*", "/me", "/me/*", "/boards", "/boards/*", "/invites", "/invites/*", "/github-app", "/github-app/*", "/webhooks/*", "/presence/*", "/users/*", "/workspaces", "/workspaces/*", "/access-changes/*"]
  },
  // Safety-net collection for historical/unregistered R2 objects. Normal
  // attachment, card and column deletion is immediate through BoardDO alarms.
  "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
  "vars": {
    // Everything GitHub (linking an account, signing in, connected repos and
    // development info) is off until an Admin has created the instance GitHub App
    // with the button. foxban keeps the App's id and secrets itself, so none of
    // them is configured here.
    "GITHUB_OAUTH_BASE": "https://github.com",
    "GITHUB_API_BASE": "https://api.github.com"
    // ADMIN_EMAILS is a secret, not a var (a var and a secret of the same name
    // conflict): comma-separated full addresses (a `*@domain` entry is ignored, ADR
    // 0071). Admins may sign up without an invite and are the only ones who can mint them.
    // Locally it comes from apps/api/.dev.vars.
    // GITHUB_APP_ENCRYPTION_KEY is a secret too: scripts/deploy.mjs generates it
    // once and never overwrites it. It seals the instance GitHub App's secrets in D1.
  },
  // Ten password attempts per minute per IP: generous for a human, useless for a
  // cracker. Two instances on one account need different namespace ids.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Password attempts per account (keyed by email), across all IPs. Higher than the
    // per-IP limit, so one IP alone (capped at 10) cannot lock an account out.
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 50, "period": 60 }
    }
  ]
}
