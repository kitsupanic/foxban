# Inputs for `pnpm run deploy` (scripts/deploy.mjs). Copy to .env.deploy (git-ignored)
# and fill in. Real environment variables win over this file, so CI can set them
# directly. Cloudflare auth is wrangler's own: `wrangler login`, or set
# CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID. If your login can see more than one
# Cloudflare account, set CLOUDFLARE_ACCOUNT_ID too.

# Required. Comma-separated full addresses or *@domain wildcards. Admins can sign
# up without an invite and are the only ones who can mint invites.
ADMIN_EMAILS=you@example.com

# Worker name; the default URL is https://<WORKER_NAME>.<your-subdomain>.workers.dev
# WORKER_NAME=foxban
# D1 database and R2 bucket are created on first deploy if missing.
# D1_DATABASE_NAME=foxban
# R2_BUCKET_NAME=foxban-attachments

# Serve from your own hostname instead of workers.dev (the zone must be on this
# Cloudflare account). Turns workers.dev off.
# CUSTOM_DOMAIN=kanban.example.com

# Two instances on one Cloudflare account need different rate-limit namespace ids.
# RATE_LIMIT_NAMESPACE_ID=1001

# Public origin of the app, only if the request origin is not right (e.g. behind a proxy).
# APP_ORIGIN=https://kanban.example.com

# The deploy creates the GITHUB_APP_ENCRYPTION_KEY secret itself, once, and never
# overwrites it. It seals the GitHub App's secrets that foxban stores when an Admin
# presses "Create GitHub App". Do not set it here.

# GitHub needs no setting here: an Admin presses "Create GitHub App" in foxban.
